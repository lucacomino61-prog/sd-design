---
import '../styles/global.css';
const work = [
  { id: 'elixir', name: 'elixir.al', kind: 'Shop', state: 'Live', live: true },
  { id: 'martiri', name: 'Bar Martiri', kind: 'Website', state: 'Live', live: true },
  { id: 'greta', name: 'Dresses by Greta', kind: 'Shop', state: 'Preview' },
  { id: 'beed', name: 'BeeD Energy', kind: 'Marketplace', state: 'Prototype' },
  { id: 'divjaka', name: 'Divjaka, Hotel Pelikan', kind: 'Platform', state: 'Prototype' },
  { id: 'barber', name: 'Barber Bros', kind: 'Brand + website', state: 'Ready' },
  { id: 'kater', name: 'Katër Burgers', kind: 'Website', state: 'Live', live: true },
];
const lab = [
  { id: 'shah', name: 'Shah', kind: 'Chess coach', state: 'Live', live: true },
  { id: 'hold', name: 'Hold Please', kind: 'Party game', state: 'Live', live: true },
  { id: 'lindja', name: 'LINDJA', kind: 'World film', state: 'Prototype' },
  { id: null, name: 'KAYO', kind: 'Redesign', state: 'Concept' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>SD Design · Design studio in Albania</title>
  <meta name="description" content="SD Design designs and builds websites, online shops, platforms and brands in Albania, in Albanian, English and Italian." />
  <meta name="theme-color" content="#0b0c0f" />
  <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <div class="loader" id="loader" aria-live="polite">
    <div class="count" id="count">0</div>
    <div class="row"><span>SD Design · switching the lights on</span><button type="button" id="skip">Skip intro</button></div>
    <div class="bar-line" id="barline"></div>
  </div>
  <div id="gl" aria-hidden="true"></div>
  <div class="cursor" id="cursor" aria-hidden="true"><span id="cursor-t"></span></div>

  <header class="bar">
    <a class="logo" href="#top" aria-label="SD Design, home">
      <svg viewBox="0 0 707 488" aria-hidden="true"><path fill="#f1ece4" d="M160.2 405.8Q112.2 405.8 76.6 391.1Q41 376.3 21.1 347.4Q1.3 318.4 0 275.9H79.7Q81.3 296.1 91.8 309.7Q102.3 323.2 119.8 329.9Q137.2 336.7 159.3 336.7Q181.2 336.7 197.5 330.3Q213.8 323.9 222.9 312.4Q232 300.8 232 285.7Q232 271.9 223.8 262.6Q215.7 253.4 200.3 246.8Q185 240.1 163.1 234.9L119.1 224Q68.3 211.6 39.5 185.2Q10.7 158.7 10.7 115.1Q10.7 78.9 30.3 51.8Q49.8 24.7 83.8 9.7Q117.8 -5.4 161.2 -5.4Q205.6 -5.4 238.6 9.8Q271.6 25 290.1 51.9Q308.5 78.9 309.2 114H229.9Q227.6 89.9 209.4 76.7Q191.1 63.5 160.5 63.5Q139.6 63.5 124.9 69.5Q110.1 75.5 102.4 86Q94.7 96.5 94.7 109.9Q94.7 124.6 103.7 134.3Q112.6 144 127.3 150.1Q142 156.2 158.8 160.3L194.9 169.1Q220.1 174.8 241.9 184.5Q263.7 194.2 280 208.3Q296.4 222.4 305.4 241.6Q314.5 260.9 314.5 286.1Q314.5 322.5 296.2 349.4Q277.8 376.4 243.3 391.1Q208.8 405.8 160.2 405.8Z"/><path fill="#e83a2c" d="M362.5 0H506.5A200 200 0 0 1 506.5 400H482.5L322.5 488L362.5 360Z"/></svg>
      SD Design
    </a>
    <div class="bar-r">
      <a class="pill" href="#work" data-go="2">Work <span aria-hidden="true">11</span></a>
      <a class="pill red" href="#say" data-go="4"><i aria-hidden="true"></i>Let's talk</a>
    </div>
  </header>

  <section class="hero" id="top" aria-labelledby="h1">
    <p class="eyebrow"><b>SD Design</b> Design studio · Albania · <span id="clock">--:--</span></p>
    <h1 id="h1"><span class="w"><span>We make the</span></span> <span class="w"><span>websites</span></span> <span class="w"><span>businesses</span></span> <span class="w"><span>are <em>proud of.</em></span></span></h1>
    <p>Websites, online shops, booking platforms and brands, designed and built in this room. In Albanian, English and Italian.</p>
  </section>
  <p class="scrollhint" aria-hidden="true">Scroll to look around<span>or click anything that glows</span></p>

  <button class="tag" type="button" data-tag="1" data-go="1"><span class="dot"></span><span class="txt"><b>01</b>What we do</span></button>
  <button class="tag" type="button" data-tag="2" data-go="2"><span class="dot"></span><span class="txt"><b>02</b>The work</span></button>
  <button class="tag" type="button" data-tag="3" data-go="3"><span class="dot"></span><span class="txt"><b>03</b>The lab</span></button>
  <button class="tag" type="button" data-tag="4" data-go="4"><span class="dot"></span><span class="txt"><b>04</b>Say hi</span></button>

  <main id="content">
    <div class="chapter" data-stop="0"></div>
    <div class="chapter" data-stop="1"></div>
    <div class="chapter" id="work" data-stop="2"></div>
    <div class="chapter" data-stop="3"></div>
    <div class="chapter" id="say" data-stop="4"></div>
  </main>

  <section class="panel right" data-panel="1" aria-labelledby="p1">
    <span class="k"><b>01</b> What we do</span>
    <h2 id="p1">Four things, done here.</h2>
    <ul class="list">
      <li>Websites<small>Design · front end · back end</small></li>
      <li>Online shops<small>Basket · checkout · admin</small></li>
      <li>Platforms<small>Bookings · marketplaces</small></li>
      <li>Brands<small>Mark · colour · type</small></li>
    </ul>
  </section>
  <section class="panel left" data-panel="2" aria-labelledby="p2">
    <span class="k"><b>02</b> The work · on the screen</span>
    <h2 id="p2">Eleven projects.</h2>
    <ul class="list">
      {work.map((w) => <li data-shot={w.id}>{w.name}<small class={w.live ? 'live' : ''}>{w.kind} · {w.state}</small></li>)}
    </ul>
    <p class="note" style="margin-top:14px">Point at a name to put it on the screen.</p>
  </section>
  <section class="panel left" data-panel="3" aria-labelledby="p3">
    <span class="k"><b>03</b> The lab · on the TV</span>
    <h2 id="p3">What we build for fun.</h2>
    <ul class="list">
      {lab.map((w) => <li data-shot={w.id ?? undefined}>{w.name}<small class={w.live ? 'live' : ''}>{w.kind} · {w.state}</small></li>)}
    </ul>
  </section>
  <section class="panel right" data-panel="4" aria-labelledby="p4">
    <span class="k"><b>04</b> Say hi · leave a note</span>
    <h2 id="p4">Tell us what you need.</h2>
    <p>We answer in Albanian, English or Italian.</p>
    <form class="say" id="say-form">
      <label class="sr" for="say-name">Your name and business</label><input id="say-name" autocomplete="name" placeholder="Your name and business" />
      <label class="sr" for="say-msg">What do you need?</label><textarea id="say-msg" placeholder="A website for my restaurant in Durrës…"></textarea>
      <button class="pill red" type="submit">Send the note</button>
    </form>
  </section>

  <section class="after" aria-labelledby="all">
    <h2 id="all">Everything, as a list.</h2>
    <ul class="index">
      {[...work, ...lab].map((w) => <li>{w.name}<small>{w.kind} · {w.state}</small></li>)}
    </ul>
    <div class="foot"><span>SD Design · Albania</span><span>Models: Poly Haven (CC0)</span><span>Draft, not live</span></div>
  </section>

  <div class="toggles"><button class="pill" type="button" id="snd" aria-pressed="false">Sound off</button><button class="pill" type="button" id="mot" aria-pressed="true">Motion on</button></div>
  <div class="toast" id="toast" role="status"></div>
  <script>import '../scripts/studio.js';</script>
</body>
</html>
