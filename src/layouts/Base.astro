---
// The shell every page shares: the head (title, description, canonical, languages, share image, icons, structured
// data), the glass bar with the menu, the closing contact block, the footer and the ruled rail. Every word is in the
// HTML; the script adds the motion, and the page reads and links without it.
// Every WhatsApp button on a page starts the same request for the free draft; `type` writes the kind of business
// into it and `label` is that page's wording for the button.
// A page whose words are not in the dictionary's `meta` hands in its own title and description (`meta`) and share
// image (`share`). `wear` names a client: the page then opens in that client's colour (see src/styles/project.css).
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import Close from '../components/Close.astro';
import { SITE, DRAFT, VISITS, LANGS, LANG_NAME, LOCALE, PAGES, SERVICES, href, abs, wa, tel, ig, offerMsg, workHref, S_PATH, BUBBLE } from '../data/site.js';
import { FEATURES } from '../data/features.js';
import { CONTACT } from '../data/contact.js';
import { SITES, ORDER, LIVE } from '../data/sites.js';
import { GUIDE_TEXT } from '../i18n/guides.js';

const { t, page, nodes = [], sections = 1, type = '', label = t.home.cta, close = true, wear = '' } = Astro.props;
const lang = t.lang;
const meta = Astro.props.meta ?? t.meta[page];
const msg = offerMsg(t, type);
const path = PAGES[page]?.[lang] ?? null; // a page without a place in the table (the 404) is never indexed
const home = href('home', lang);
const other = (l) => PAGES[page]?.[l] ?? href('home', l);
const share = Astro.props.share ?? `/og/${['home', 'offer', ...SERVICES].includes(page) ? page : 'home'}-${lang}.jpg`;
const year = new Date().getFullYear();
const pad = (n) => String(n).padStart(2, '0');

// Structured data: who the studio is, what the site is, what this page is. Details that are not known are left out.
const ORG = abs('/') + '#studio', WEB = abs('/') + '#site';
const org = {
  '@type': 'Organization', '@id': ORG, name: SITE.name, url: abs('/'), logo: abs('/icons/icon-512.png'), description: t.meta.home.desc,
  areaServed: { '@type': 'Country', name: 'Albania' }, knowsLanguage: ['sq', 'en', 'it'],
  ...(CONTACT.instagram && { sameAs: [`https://instagram.com/${CONTACT.instagram}`] }),
  ...((CONTACT.phone || CONTACT.email) && { contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', availableLanguage: ['sq', 'en', 'it'], ...(CONTACT.phone && { telephone: CONTACT.phone }), ...(CONTACT.email && { email: CONTACT.email }) } }),
  ...(SITE.legal.name && { legalName: SITE.legal.name }), ...(SITE.legal.nipt && { taxID: SITE.legal.nipt }),
};
const graph = [
  org,
  { '@type': 'WebSite', '@id': WEB, url: abs('/'), name: SITE.name, inLanguage: ['sq', 'en', 'it'], publisher: { '@id': ORG } },
  ...(path ? [{ '@type': 'WebPage', '@id': abs(path) + '#page', url: abs(path), name: meta.title, description: meta.desc, inLanguage: lang, isPartOf: { '@id': WEB }, about: { '@id': ORG }, primaryImageOfPage: { '@type': 'ImageObject', url: abs(share), width: 1200, height: 630 } }] : []),
  ...nodes,
];
const safe = (o) => JSON.stringify(o).replace(/</g, '\\u003c');
const client = { toast: t.toast, eggs: t.eggs, bar: t.bar, form: { ...t.contact, endpoint: CONTACT.formEndpoint, fields: CONTACT.formFields, whatsapp: CONTACT.whatsapp }, ...(FEATURES.source && { from: t.ui.from }) };
const menu = [[href('offer', lang), t.nav.offer], [`${home}#work`, t.nav.work], ...SERVICES.map((k) => [href(k, lang), t.kinds[k]]), ['#contact', t.nav.contact]];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{meta.title}</title>
  {meta.desc && <meta name="description" content={meta.desc} />}
  {(DRAFT || !path) && <meta name="robots" content="noindex" />}
  {SITE.build && <meta name="build" content={SITE.build} />}
  {path && <link rel="canonical" href={abs(path)} />}
  {path && LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(PAGES[page][l])} />)}
  {path && <link rel="alternate" hreflang="x-default" href={abs(PAGES[page].sq)} />}
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#1a1c1c" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={meta.title} />
  {meta.desc && <meta property="og:description" content={meta.desc} />}
  {path && <meta property="og:url" content={abs(path)} />}
  <meta property="og:locale" content={LOCALE[lang]} />
  {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LOCALE[l]} />)}
  <meta property="og:image" content={abs(share)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={meta.title} />
  <meta name="twitter:card" content="summary_large_image" />
  {SITE.verify.google && <meta name="google-site-verification" content={SITE.verify.google} />}
  {SITE.verify.bing && <meta name="msvalidate.01" content={SITE.verify.bing} />}
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="apple-mobile-web-app-title" content={SITE.name} />
  <link rel="preload" href="/fonts/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={safe({ '@context': 'https://schema.org', '@graph': graph })} />
  <script type="speculationrules" is:inline>{"prerender":[{"where":{"and":[{"href_matches":"/*"},{"not":{"selector_matches":"[target=_blank]"}}]},"eagerness":"moderate"}]}</script>
</head>
<body data-page={page} class={wear ? `t-${wear} worn` : undefined}>
  <a class="skip" href="#main">{t.ui.skip}</a>
  <header class="bar on-dark">
    <a class="logo" id="logo" href={home} aria-label={t.ui.home}><svg viewBox="0 0 707 488" aria-hidden="true"><path d={S_PATH} /><path class="bub" d={BUBBLE} /></svg></a>
    <p class="msg" aria-hidden="true"><span id="msg">{t.bar[0]}</span></p>
    <button type="button" class="burger" id="burger" aria-expanded="false" aria-controls="nav" aria-label={t.ui.menu}><i></i><i></i></button>
    <nav class="nav" id="nav" aria-label={t.ui.navLabel} inert>
      {menu.map(([to, text]) => <a href={to} aria-current={to === path ? 'page' : undefined}>{text}<Icon name="arrow-up-right" size={12} /></a>)}
      <a {...wa(msg)}>WhatsApp<Icon name="arrow-up-right" size={12} /></a>
      <p>{LANGS.map((l) => <a href={other(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_NAME[l]}</a>)}</p>
    </nav>
  </header>
  <a class="touch on-dark" {...wa(msg)}><span><Icon name="whatsapp-logo" size={16} /></span>{t.nav.offer}</a>

  <main id="main">
    <slot />
    {close && <Close t={t} label={label} type={type} n={sections} />}
  </main>

  <footer class="foot on-dark">
    <canvas class="tone foot-tone" data-tone="mark" aria-hidden="true"></canvas>
    <div class="foot-in">
      <nav class="foot-nav" aria-label={t.foot.services}>
        <div><h2>{t.foot.services}</h2><ul>{SERVICES.map((k) => <li><a href={href(k, lang)}>{t.kinds[k]}</a></li>)}<li><a href={href('offer', lang)} aria-current={page === 'offer' ? 'page' : undefined}>{t.nav.offer}</a></li>{PAGES.guides && <li><a href={href('guides', lang)} aria-current={page.startsWith('guide') ? 'page' : undefined}>{GUIDE_TEXT[lang].nav}</a></li>}</ul></div>
        <div><h2>{t.foot.work}</h2><ul>{ORDER.map((id) => <li><a href={workHref(id, lang)} aria-current={page === `work-${id}` ? 'page' : undefined}>{SITES[id].name}</a></li>)}</ul></div>
        <div><h2>{t.foot.contact}</h2><ul><li><a {...wa(msg)}>WhatsApp</a></li><li><a {...tel}>{t.contact.tel}</a></li><li><a {...ig}>Instagram</a></li><li><a href={href('privacy', lang)}>{t.nav.privacy}</a></li></ul></div>
        <div><h2>{t.foot.langs}</h2><ul>{LANGS.map((l) => <li><a href={other(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_NAME[l]}</a></li>)}</ul></div>
      </nav>
      <p class="fine"><span>© {year} {SITE.name}</span><span>{t.foot.line}</span>{DRAFT && <span class="fine-draft">{t.ui.draft}</span>}</p>
    </div>
  </footer>

  <div class="rail on-dark" role="group" aria-label={SITE.name}>
    <span class="rail-a">{t.ui.count.replace('{n}', ORDER.length).replace('{m}', LIVE.length)}</span>
    <span class="rail-clock">{t.ui.clock} <time data-clock>--:--</time></span>
    <a class="rail-wa" {...wa(msg)}><Icon name="whatsapp-logo" size={16} />{t.nav.offer}</a>
    <span class="rail-count" aria-hidden="true">&lt; <b id="count">01</b> / {pad(sections)} &gt;</span>
    <button type="button" class="still" data-still aria-pressed="false">{t.ui.still}</button>
    <nav class="rail-langs" aria-label={t.ui.langLabel}>{LANGS.map((l) => <a href={other(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} aria-label={LANG_NAME[l]}>{l.toUpperCase()}</a>)}</nav>
  </div>

  <div class="kafe on-dark" id="kafe" role="dialog" aria-labelledby="kafe-t" hidden>
    <Icon name="coffee" size={40} />
    <div>
      <p class="kafe-t" id="kafe-t"><span lang="sq">{t.eggs.kafe.t}</span>{t.eggs.kafe.tr && <small>{t.eggs.kafe.tr}</small>}</p>
      <p>{t.eggs.kafe.s}</p>
      <a class="lnk" {...wa(t.eggs.kafe.msg)}>{t.eggs.kafe.cta}<Icon name="arrow-up-right" size={12} /></a>
    </div>
    <button type="button" class="kafe-x" id="kafe-x" aria-label={t.eggs.kafe.close}><Icon name="x" size={16} /></button>
  </div>
  <div class="draft" id="draft" role="status"></div>
  <script type="application/json" id="i18n" set:html={safe(client)} />
  <script>import '../scripts/site.js';</script>
  {VISITS && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: VISITS })}></script>}
</body>
</html>
