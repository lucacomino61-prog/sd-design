---
// Option C, "The Glass". Follows Lama Lama (lamalama.com, Awwwards jury 7.51): a dark ground, footage shown through a
// dot matrix, a three-line manifesto in capitals, a glass bar for navigation, a ruled bottom rail with the clock and
// a page counter, and the work as ruled rows that open. The footage here is a client's own site, drawn as a halftone.
import '../../styles/options/base.css';
import '../../styles/options/c.css';
import OptionHead from '../../components/OptionHead.astro';
import Icon from '../../components/Icon.astro';
import t from '../../i18n/sq.js';
import { SITES } from '../../data/sites.js';
import { ORDER, KIND, FEATURES, S_PATH, BUBBLE, wa, tel, ig } from '../../data/options.js';

const hero = SITES.martiri, second = SITES.kater;
const lines = [t.h1a.split(',')[0] + ',', t.h1a.split(', ')[1].replace(/ e$/, ''), 'e ' + t.h1b];
const SECTIONS = 4;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="sq">
<head><OptionHead title="SD Design · Opsioni C, Xhami" /></head>
<body class="c">
  <a class="skip" href="#main">Kalo te përmbajtja</a>
  <header class="c-bar">
    <a class="c-logo" href="#top" aria-label="SD Design, në krye"><svg viewBox="0 0 707 488" aria-hidden="true"><path d={S_PATH} /><path class="c-bub" d={BUBBLE} /></svg></a>
    <p class="c-msg" aria-hidden="true"><span data-msgs="Mirë se erdhe|Pimë një kafe?|Na shkruani në WhatsApp">Mirë se erdhe</span></p>
    <button type="button" class="c-burger" id="c-burger" aria-expanded="false" aria-controls="c-nav" aria-label="Menu"><i></i><i></i></button>
    <nav class="c-nav" id="c-nav" aria-label="Kryesore" inert>
      <a href="#work">Punët<Icon name="arrow-up-right" size={12} /></a>
      <a href="#who">Çfarë bëjmë<Icon name="arrow-up-right" size={12} /></a>
      <a href="#contact">Kontakt<Icon name="arrow-up-right" size={12} /></a>
      <a {...wa(t.waMsg)}>WhatsApp<Icon name="arrow-up-right" size={12} /></a>
      <p><span lang="sq">Shqip</span><a href="/en/" lang="en">English</a><a href="/it/" lang="it">Italiano</a></p>
    </nav>
  </header>
  <a class="c-touch" {...wa(t.waMsg)}><span><Icon name="whatsapp-logo" size={16} /></span>Na shkruani</a>

  <main id="main">
    <section class="c-hero" id="top" aria-labelledby="c-h1" data-section="1">
      <canvas class="c-tone" data-tone data-from="#c-live" aria-hidden="true"></canvas>
      <figure class="c-live" id="c-live" data-video={hero.video} data-poster={hero.poster}>
        <img src={hero.poster} alt={t.onPhone.replace('{name}', hero.name)} width="390" height="844" />
        <figcaption>[ {hero.name} ]</figcaption>
      </figure>
      <div class="c-hero-b">
        <div>
          <p class="c-tag">[ SD Design · Studio dizajni ]</p>
          <h1 id="c-h1">{lines.map((l, i) => <span class="c-ln"><span style={`--i:${i}`}>{l}</span></span>)}</h1>
        </div>
        <p class="c-lead">{t.lead}</p>
      </div>
    </section>

    <section class="c-work" id="work" aria-labelledby="c-work-h" data-section="2">
      <div class="c-work-top">
        <p class="c-say" id="c-work-h">Ndërtojmë faqe për bizneset shqiptare: restorante, hotele, dyqane dhe klinika. Ja disa prej tyre, ashtu siç i shohin klientët në telefon.</p>
        <p class="c-tag">[ Punët ]</p>
      </div>
      <div class="c-rows">
        {ORDER.map((id) => {
          const s = SITES[id];
          return (
            <details class="c-row" name="c-work">
              <summary>
                <span class="c-name">{s.name}</span>
                <span class="c-chips"><i>{t.tabs[KIND[id]]}</i><i>{t.states[s.state]}</i></span>
                <span class="c-plus" aria-hidden="true"></span>
                <span class="c-thumbs" aria-hidden="true"><img src={s.shot} alt="" width="1440" height="900" loading="lazy" decoding="async" /><img src={s.poster} alt="" width="390" height="844" loading="lazy" decoding="async" /><img class="c-t3" src={s.shot} alt="" width="1440" height="900" loading="lazy" decoding="async" /></span>
              </summary>
              <div class="c-open">
                <div class="c-info">
                  <p>{t.work.what[id]}</p>
                  <ul>{FEATURES[id].map((f) => <li>{f}</li>)}</ul>
                  {s.url && <a href={s.url} target="_blank" rel="noopener">{t.work.visit}<Icon name="arrow-up-right" size={12} /></a>}
                </div>
                <img class="c-shot" src={s.shot} alt={t.work.shotAlt.replace('{name}', s.name)} width="1440" height="900" loading="lazy" decoding="async" />
                <figure class="c-phone" data-site={id} data-video={s.video}><img src={s.poster} alt={t.onPhone.replace('{name}', s.name)} width="390" height="844" loading="lazy" decoding="async" /></figure>
              </div>
            </details>
          );
        })}
      </div>
    </section>

    <section class="c-what" id="who" aria-labelledby="c-what-h" data-section="3">
      <canvas class="c-tone c-tone-dim" data-tone data-video={second.video} data-poster={second.poster} aria-hidden="true"></canvas>
      <h2 id="c-what-h">Çfarë bëjmë.</h2>
      <ul class="c-kinds">{Object.values(t.tabs).map((x) => <li>{x}</li>)}</ul>
      <p class="c-lead">{t.who.sub} {t.contact.sub}</p>
      <ul class="c-cols">
        {t.who.cards.map(([, name, items, cta, msg]) => (
          <li>
            <h3>[ {name} ]</h3>
            <ul>{items.map((x) => <li>{x}</li>)}</ul>
            <a {...wa(msg)}>{cta}<Icon name="arrow-up-right" size={12} /></a>
          </li>
        ))}
      </ul>
    </section>

    <section class="c-end" id="contact" aria-labelledby="c-end-h" data-section="4">
      <p class="c-tag">[ Kontakt ]</p>
      <h2 id="c-end-h">Na tregoni<br />biznesin tuaj.</h2>
      <div class="c-end-b">
        <a class="c-cta" {...wa(t.waMsg)}><span><Icon name="whatsapp-logo" size={18} /></span>Na shkruani në WhatsApp</a>
        <p>{t.contact.sub}</p>
        <ul><li><a {...tel}>{t.contact.tel}<Icon name="arrow-up-right" size={12} /></a></li><li><a {...ig}>Instagram<Icon name="arrow-up-right" size={12} /></a></li></ul>
      </div>
      <p class="c-fine">© {year} SD Design</p>
    </section>
  </main>

  <footer class="c-rail">
    <span>{ORDER.length} faqe</span>
    <span class="c-rail-clock">Shqipëri <time data-clock>--:--</time></span>
    <span class="c-count" aria-hidden="true">&lt; <b id="c-count">01</b> / {String(SECTIONS).padStart(2, '0')} &gt;</span>
    <button type="button" class="c-still" data-still aria-pressed="false">Ndalo lëvizjen</button>
    <a {...wa(t.waMsg)}>WhatsApp</a>
  </footer>
  <script>import '../../scripts/options/c.js';</script>
</body>
</html>
