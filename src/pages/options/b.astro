---
// Option B, "The Split". Follows Jam Area (jamarea.com, by ET Studio, Awwwards jury 7.51): the wordmark split in two
// with the positioning line in the gap, the work as small cards scattered over white space, one curve for every
// move (expo-out, 1 s). Their home is a single screen; ours continues into a list, because the brief needs one.
import '../../styles/options/base.css';
import '../../styles/options/b.css';
import OptionHead from '../../components/OptionHead.astro';
import t from '../../i18n/sq.js';
import { SITES } from '../../data/sites.js';
import { ORDER, wa, tel, ig } from '../../data/options.js';

// where the cards sit on the first screen, in % of it (the reference scatters seven on a 12-column grid)
const SPOT = [[10.4, 12], [26.7, 12], [68.4, 12], [18.8, 31], [43, 31], [59.7, 31]];
const WORD = { food: 'Restorante', hotel: 'Hotele', shop: 'Dyqane', clinic: 'Klinika' };
const title = (id) => `${SITES[id].name} - ${t.work.what[id]}`;
const kafe = t.eggs.kafe.msg;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="sq">
<head>
  <OptionHead title="SD Design · Opsioni B, Ndarja" />
  <link rel="preload" href="/fonts/anton-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body class="b">
  <a class="skip" href="#main">Kalo te përmbajtja</a>
  <header class="b-top">
    <div class="b-left">
      <button type="button" class="b-menu" id="b-menu" aria-expanded="false" aria-controls="b-nav"><i aria-hidden="true"></i><span>Menu</span></button>
      <button type="button" class="b-still" data-still aria-pressed="false" aria-label="Ndalo lëvizjen"><i aria-hidden="true"></i><span>Ndalo</span></button>
    </div>
    <p class="b-title" id="b-title" aria-hidden="true">{title(ORDER[0])}</p>
    <a class="b-write" {...wa(t.waMsg)}><span>Shkruaj</span><i aria-hidden="true"></i></a>
  </header>
  <nav class="b-nav" id="b-nav" aria-label="Kryesore" inert>
    <a href="#list">Punët</a>
    <a href="#who">Për kë punojmë</a>
    <a href="#contact">Kontakt</a>
    <p><span lang="sq">Shqip</span><a href="/en/" lang="en">English</a><a href="/it/" lang="it">Italiano</a></p>
  </nav>

  <main id="main">
    <section class="b-first" aria-labelledby="b-h1">
      <ul class="b-cards">
        {ORDER.map((id, i) => (
          <li style={`--x:${SPOT[i][0]}%;--y:${SPOT[i][1]}%`}>
            <a href={`#p-${id}`} data-title={title(id)} data-video={SITES[id].video}>
              <img src={SITES[id].poster} alt={title(id)} width="390" height="844" />
            </a>
          </li>
        ))}
        <li class="b-yours" style="--x:84.4%;--y:31%"><a {...wa('Përshëndetje SD Design, dua që faqja ime të jetë e radhës.')}><span aria-hidden="true">+</span>Faqja juaj?</a></li>
      </ul>
      <div class="b-word">
        <span class="b-w b-w1" aria-hidden="true">SD</span>
        <div class="b-mid">
          <h1 id="b-h1"><span>©SD Design</span><span>Studio dizajni</span><span>Faqe interneti</span><span>dhe dyqane online</span></h1>
          <a class="b-cta" {...wa(kafe)}>Pimë një kafe?</a>
        </div>
        <span class="b-w b-w2" aria-hidden="true">Design</span>
      </div>
    </section>

    <section class="b-list" id="list" aria-labelledby="b-list-h">
      <h2 class="b-h" id="b-list-h"><span>Punët</span><span>{ORDER.length}</span></h2>
      <ol>
        {ORDER.map((id) => {
          const s = SITES[id];
          const Row = s.url ? 'a' : 'div';
          return (
            <li id={`p-${id}`}>
              <Row class="b-row" href={s.url} target={s.url && '_blank'} rel={s.url && 'noopener'} data-video={s.video} data-poster={s.poster}>
                <span class="b-name">{s.name.split(' · ')[0]}</span>
                <span class="b-meta"><span>{[s.name.split(' · ')[1], t.work.what[id]].filter(Boolean).join(' · ')}</span><span>{s.url ? t.work.visit : t.states[s.state]}</span></span>
                <img class="b-thumb" src={s.poster} alt="" width="390" height="844" loading="lazy" decoding="async" />
              </Row>
            </li>
          );
        })}
      </ol>
      <div class="b-peek" aria-hidden="true"><div class="b-peek-in"></div></div>
    </section>

    <section class="b-who" id="who" aria-labelledby="b-who-h">
      <h2 class="b-h" id="b-who-h"><span>Për kë punojmë</span><span>{t.who.cards.length}</span></h2>
      <ul>
        {t.who.cards.map(([k, name, items, cta, msg]) => (
          <li>
            <h3>{WORD[k]}</h3>
            <div>
              <p>{name}</p>
              <ul>{items.map((x) => <li>{x}</li>)}</ul>
              <a {...wa(msg)}>{cta}</a>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="b-end" id="contact" aria-labelledby="b-end-h">
      <h2 id="b-end-h"><a {...wa(kafe)}>Pimë një kafe?</a></h2>
      <ul class="b-links">
        <li><a {...wa(t.waMsg)}>WhatsApp</a></li>
        <li><a {...tel}>{t.contact.tel}</a></li>
        <li><a {...ig}>Instagram</a></li>
      </ul>
      <p class="b-foot"><span><time data-clock>--:--</time> Shqipëri</span><span>Shqip · English · Italiano</span><span>© {year} SD Design</span></p>
    </section>
  </main>
  <script>import '../../scripts/options/b.js';</script>
</body>
</html>
