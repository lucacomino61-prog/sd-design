---
// Option A, "The Block". Follows M&C 4.0 (mallardandclaret.com, Awwwards jury 7.58): the identity in one screen
// (logotype on a colour block, one positioning line, the clock, a small video card), then every project as a
// full-screen panel that slides over the last one. One typeface, three sizes, a 2vw spacer.
import '../../styles/options/base.css';
import '../../styles/options/a.css';
import OptionHead from '../../components/OptionHead.astro';
import Icon from '../../components/Icon.astro';
import t from '../../i18n/sq.js';
import { SITES } from '../../data/sites.js';
import { TONE, ORDER, KIND, FEATURES, S_PATH, BUBBLE, wa, tel, ig } from '../../data/options.js';

// the mark assembles from blocks: a 10 x 6 grid of cells uncovers it in a fixed shuffled order
const COLS = 10, ROWS = 6;
const rank = (() => {
  const a = [...Array(COLS * ROWS).keys()];
  let s = 11;
  for (let i = a.length - 1; i > 0; i--) { s = (s * 1103515245 + 12345) & 0x7fffffff; const j = s % (i + 1); [a[i], a[j]] = [a[j], a[i]]; }
  const r = []; a.forEach((cell, k) => { r[cell] = k; });
  return r;
})();
const first = SITES.martiri;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="sq">
<head><OptionHead title="SD Design · Opsioni A, Blloku" /></head>
<body class="a">
  <a class="skip" href="#main">Kalo te përmbajtja</a>
  <header class="a-top">
    <a class="a-name" href="#top">SD Design</a>
    <span class="a-tag">Studio dizajni · Shqipëri</span>
    <nav class="a-nav" aria-label="Kryesore"><a href="#work">Punët</a><a href="#who">Për kë punojmë</a><a href="#contact">Kontakt</a></nav>
    <a class="a-pill" {...wa(t.waMsg)}>Na shkruani</a>
  </header>

  <main id="main">
    <section class="a-block" id="top" aria-labelledby="a-h1">
      <div class="a-mark">
        <svg viewBox="0 0 707 488" role="img" aria-label="SD Design">
          <path d={S_PATH} /><path d={BUBBLE} />
          <g class="a-dots" aria-hidden="true"><circle cx="436" cy="200" r="21" /><circle cx="506" cy="200" r="21" /><circle cx="576" cy="200" r="21" /></g>
        </svg>
        <div class="a-cells" aria-hidden="true">{rank.map((k) => <span style={`--k:${k}`}></span>)}</div>
      </div>
      <div class="a-say">
        <h1 id="a-h1">Faqe interneti, dyqane online dhe rezervime për bizneset shqiptare.</h1>
        <p class="a-facts"><span><time data-clock>--:--</time> Shqipëri</span><span>Shqip · English · Italiano</span><button type="button" class="a-still" data-still aria-pressed="false">Ndalo lëvizjen</button></p>
      </div>
      <a class="a-card" href="#work" aria-label="Shiko punët" data-video={first.video}><img src={first.poster} alt="" width="390" height="844" /></a>
    </section>

    <section class="a-work" id="work" aria-label="Punët">
      {ORDER.map((id, i) => {
        const s = SITES[id];
        return (
          <article class="a-panel" style={`--tone:${TONE[id]}`}>
            <img class="a-wash" src={s.shot} alt="" width="1440" height="900" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
            <div class="a-line">
              <div><h2>{s.name}</h2><p>{t.work.what[id]}</p></div>
              {s.url
                ? <a class="a-go" href={s.url} target="_blank" rel="noopener">Hap faqen<Icon name="arrow-up-right" size={14} /></a>
                : <span class="a-go">{t.states[s.state]}</span>}
            </div>
            <figure class="a-mini" data-site={id} data-video={s.video}><img src={s.poster} alt={t.onPhone.replace('{name}', s.name)} width="390" height="844" loading="lazy" decoding="async" /></figure>
            <ul class="a-tags"><li>{t.tabs[KIND[id]]}</li><li>{t.states[s.state]}</li></ul>
            <ul class="a-hash">{FEATURES[id].map((f) => <li>#{f}</li>)}</ul>
          </article>
        );
      })}
    </section>

    <section class="a-who" id="who" aria-labelledby="a-who-h">
      <h2 id="a-who-h">Për kë punojmë</h2>
      <ul>
        {t.who.cards.map(([, title, items, cta, msg]) => (
          <li>
            <h3>{title}</h3>
            <p>{items.join(' · ')}</p>
            <a {...wa(msg)}>{cta}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="a-end" id="contact" aria-labelledby="a-end-h">
      <svg class="a-end-mark" viewBox="0 0 707 488" aria-hidden="true"><path d={S_PATH} /><path d={BUBBLE} /></svg>
      <div class="a-end-say">
        <h2 id="a-end-h">{t.contact.t}<br />{t.contact.sub}</h2>
        <ul>
          <li><a {...wa(t.waMsg)}>WhatsApp</a></li>
          <li><a {...tel}>{t.contact.tel}</a></li>
          <li><a {...ig}>Instagram</a></li>
        </ul>
        <p class="a-facts"><span><time data-clock>--:--</time> Shqipëri</span><span>© {year} SD Design</span></p>
      </div>
    </section>
  </main>
  <script>import '../../scripts/options/a.js';</script>
</body>
</html>
