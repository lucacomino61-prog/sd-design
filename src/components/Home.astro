---
// The home page in one language, built around one offer: a free working draft of the visitor's own site.
// First screen: the line, the one WhatsApp button, how many drafts are left this week and who answers, over a client's
// site drawn as a red halftone. Then the offer in three numbers, how it works step by step, the sites already built
// (a row of phones, then the list), every kind of site by difficulty, why, the questions, and the close (from the
// layout). Every word is in the HTML; the script adds the movement.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Words from './Words.astro';
import Ask from './Ask.astro';
import Story from './Story.astro';
import Reel from './Reel.astro';
import Work from './Work.astro';
import Faq from './Faq.astro';
import { SERVICES, href, abs, wa, offerMsg } from '../data/site.js';
import { SITES, ORDER, HERO } from '../data/sites.js';
import { OFFER } from '../data/offer.js';

const { t } = Astro.props;
const lang = t.lang, h = t.home, o = t.offer, L = t.levels;
const named = (s, name) => s.replace('{name}', name);
const first = SITES[HERO[0]];
const live = HERO.map((id) => ({ id, name: SITES[id].name, video: SITES[id].video, poster: SITES[id].poster, alt: named(t.ui.onPhone, SITES[id].name) }));
// the offer in three numbers: hours, drafts a week, and what the draft costs
const numbers = [OFFER.hours, OFFER.perWeek, 0];

const ORG = abs('/') + '#studio', here = abs(href('home', lang));
const nodes = [
  { '@type': 'OfferCatalog', '@id': here + '#services', name: L.t.replace(/\.$/, ''), itemListElement: SERVICES.map((k) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: t.services[k].h1.replace(/\.$/, ''), url: abs(href(k, lang)), provider: { '@id': ORG }, areaServed: { '@type': 'Country', name: 'Albania' } } })) },
  { '@type': 'ItemList', '@id': here + '#work', name: t.nav.work, itemListElement: ORDER.map((id, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'WebSite', name: SITES[id].name, description: t.projects[id].lede, ...(SITES[id].url && { url: SITES[id].url }), inLanguage: SITES[id].langs, creator: { '@id': ORG } } })) },
  { '@type': 'FAQPage', '@id': here + '#faq', inLanguage: lang, mainEntity: h.faq.items.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base t={t} page="home" nodes={nodes} sections={8}>
  <section class="hero" id="top" aria-labelledby="h1" data-section="1">
    <canvas class="tone hero-tone" data-tone="hero" aria-hidden="true"></canvas>
    <div class="live" id="live" data-sites={JSON.stringify(live)}>
      <figure class="phone" id="live-phone" data-video={first.video}>
        <img id="live-img" src={first.poster} alt={live[0].alt} width="390" height="844" fetchpriority="high" />
      </figure>
      <p class="live-cap"><span id="live-name">{first.name}</span><i class="st st-live">{t.states.live}</i></p>
      <button type="button" class="live-next" id="live-next">{t.ui.next}<Icon name="arrow-right" size={12} /></button>
    </div>
    <div class="hero-b">
      <h1 id="h1">
        <span class="tag">{h.tag}</span><span class="sr">: </span>
        <span class="big display">{h.h1.map((line) => <span class="ln"><Words text={line} /></span>)}</span>
      </h1>
      <div class="hero-foot">
        <p class="lead">{h.lead}</p>
        <Ask t={t} />
      </div>
    </div>
  </section>

  <section class="poster" id="offer" aria-labelledby="poster-h" data-ground="red" data-section="2">
    <h2 class="sr" id="poster-h">{t.nav.offer}</h2>
    <ul class="poster-lines">
      {numbers.map((n, i) => (
        <li>
          <b class="display" aria-hidden="true" data-count={n}>{n}</b><span class="sr">{n} </span>
          <span class="display split"><Words text={o.numbers[i][0]} /></span>
        </li>
      ))}
    </ul>
  </section>

  <section class="story" id="how" aria-labelledby="how-h" data-section="3">
    <div class="story-stage">
      <h2 class="display split" id="how-h"><Words text={o.storyT} /></h2>
      <Story t={t} />
    </div>
    <div class="story-ask"><Ask t={t} note /></div>
  </section>

  <section class="work" id="work" aria-labelledby="work-h" data-section="4">
    <div class="work-top">
      <h2 class="display split" id="work-h"><Words text={h.workT} /></h2>
      <p class="say">{h.say}</p>
    </div>
    <Reel t={t} ids={ORDER} label={h.workT} pin last />
    <Work t={t} ids={ORDER} />
  </section>

  <section class="levels" id="what" aria-labelledby="what-h" data-ground="light" data-section="5">
    <div class="band display" aria-hidden="true" data-band><span>{[0, 1].map(() => <Fragment>{h.band}<i></i></Fragment>)}</span></div>
    <div class="sec-head">
      <h2 class="display split" id="what-h"><Words text={L.t} /></h2>
      <p class="lead">{L.lead}</p>
    </div>
    <ol class="stairs">
      {L.items.map(([title, text, items, eg], i) => (
        <li class="stair">
          <p class="pips" aria-hidden="true">{[0, 1, 2].map((k) => <i class={k <= i ? 'on' : undefined}></i>)}</p>
          <h3>{title}</h3>
          <p class="stair-t">{text}</p>
          <ul class="stair-list">{items.map((x) => <li>{x}</li>)}</ul>
          <a class="stair-eg" href={`#${eg}`}>
            <span class="stair-cap"><span>{L.eg}: <b>{SITES[eg].name}</b></span><Icon name="arrow-up-right" size={12} /></span>
            <img src={SITES[eg].tall} alt="" width="585" height="5064" loading="lazy" decoding="async" />
          </a>
        </li>
      ))}
    </ol>
    <div class="kinds-b">
      <h3 class="kinds-t">{L.kindsT}</h3>
      <ul class="more-list">
        {SERVICES.map((k) => <li><a href={href(k, lang)}><span class="display">{t.kindTitles[k]}</span><Icon name="arrow-up-right" size={28} /></a></li>)}
      </ul>
      <p class="levels-other">{L.other} <a class="lnk" {...wa(offerMsg(t))}>{h.cta}<Icon name="arrow-up-right" size={12} /></a></p>
    </div>
  </section>

  <section class="why" id="why" aria-labelledby="why-h" data-section="6">
    <h2 class="display split" id="why-h"><Words text={h.why.t} /></h2>
    <ol class="why-list">
      {h.why.items.map(([title, text]) => <li><h3>{title}</h3><p>{text}</p></li>)}
    </ol>
  </section>

  <section class="faq" id="faq" aria-labelledby="faq-h" data-section="7">
    <h2 class="display split" id="faq-h"><Words text={h.faq.t} /></h2>
    <div class="faq-b">
      <Faq items={h.faq.items} />
      <p class="faq-more">{h.faq.more} <a class="lnk" {...wa(h.faq.msg)}>{h.faq.ask}<Icon name="arrow-up-right" size={12} /></a></p>
    </div>
  </section>
</Base>
