---
// The privacy page: only what the site really does. It sets no cookies and stores nothing; the paragraph about the
// form follows the way the form is wired in src/data/contact.js, the one about where a visitor came from is there
// only while that line is written (`source`), and the first part changes once visits are counted (`visits` and a
// token), because the page then loads the counter from another service.
import Base from '../layouts/Base.astro';
import { SITE, DRAFT, VISITS } from '../data/site.js';
import { FEATURES } from '../data/features.js';
import { CONTACT } from '../data/contact.js';
const { t } = Astro.props;
const p = t.privacy;
const form = CONTACT.formEndpoint ? p.formInbox : p.formWa;
// a paragraph can be a place for something that depends on how the site is set up; an empty one is left out
const said = (x) => (x === '{form}' ? form : x === '{source}' ? (FEATURES.source ? p.source : null) : x);
const sections = p.sections.map(([title, paragraphs], i) => [title, (i === 0 && VISITS ? p.counted : paragraphs).map(said).filter(Boolean)]);
const who = [SITE.legal.name, SITE.legal.nipt && `NIPT ${SITE.legal.nipt}`, SITE.legal.address, CONTACT.email].filter(Boolean);
---
<Base t={t} page="privacy" sections={2}>
  <article class="doc" data-section="1">
    <h1 class="display">{p.h1}</h1>
    <p class="lead">{p.lead}</p>
    {sections.map(([title, paragraphs]) => (
      <section>
        <h2>{title}</h2>
        {paragraphs.map((x) => <p>{x}</p>)}
      </section>
    ))}
    {(who.length > 0 || DRAFT) && (
      <section>
        <h2>{p.who}</h2>
        {who.length > 0 ? <dl>{who.map((x) => <dd>{x}</dd>)}</dl> : <p>{p.whoDraft}</p>}
      </section>
    )}
  </article>
</Base>
