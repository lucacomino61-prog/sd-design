---
// The offer on a page of its own, short enough for a link in an Instagram bio or an advert: what the free draft is,
// the four steps, what to send and the terms, the sites already built, and the questions about the draft.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Words from './Words.astro';
import Ask from './Ask.astro';
import Reel from './Reel.astro';
import Faq from './Faq.astro';
import Reads from './Reads.astro';
import { href, abs, wa } from '../data/site.js';
import { SITES, ORDER, HERO } from '../data/sites.js';
import { OFFER } from '../data/offer.js';

const { t } = Astro.props;
const lang = t.lang, o = t.offer, h = t.home;
const home = href('home', lang);
const src = SITES[HERO[0]];
const terms = o.terms.map((x) => x.replace('{m}', OFFER.perWeek));
// the questions that are about the draft itself
const qs = [0, 1, 2, 3, 4, 5, 9].map((i) => h.faq.items[i]);

const ORG = abs('/') + '#studio', here = abs(href('offer', lang));
const nodes = [
  { '@type': 'Service', '@id': here + '#service', name: o.h1.replace(/\.$/, ''), description: t.meta.offer.desc, url: here, provider: { '@id': ORG }, areaServed: { '@type': 'Country', name: 'Albania' }, availableLanguage: ['sq', 'en', 'it'],
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'ALL', eligibleRegion: { '@type': 'Country', name: 'Albania' }, description: terms.join(' ') } },
  { '@type': 'FAQPage', '@id': here + '#faq', inLanguage: lang, mainEntity: qs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'SD Design', item: abs(home) }, { '@type': 'ListItem', position: 2, name: t.nav.offer, item: here }] },
];
---
<Base t={t} page="offer" nodes={nodes} sections={6}>
  <section class="hero shero" id="top" aria-labelledby="h1" data-section="1">
    <canvas class="tone hero-tone" data-tone="site" data-video={src.video} data-poster={src.poster} aria-hidden="true"></canvas>
    <div class="hero-b">
      <nav class="crumbs" aria-label={t.ui.crumbs}><ol><li><a href={home}>SD Design</a></li><li aria-current="page">{t.nav.offer}</li></ol></nav>
      <h1 class="display" id="h1">{o.h1}</h1>
      <div class="hero-foot">
        <p class="lead">{o.lead}</p>
        <Ask t={t} note />
      </div>
    </div>
  </section>

  <section class="steps" id="how" aria-labelledby="how-h" data-section="2">
    <h2 class="display split" id="how-h"><Words text={o.storyT} /></h2>
    <ol class="step-list">
      {o.steps.map(([title, text], i) => <li><span class="step-n display" aria-hidden="true">{i + 1}</span><h3>{title}</h3><p>{text}</p></li>)}
    </ol>
  </section>

  <section class="terms" id="terms" aria-labelledby="send-h" data-ground="light" data-section="3">
    <div class="terms-col">
      <h2 class="display" id="send-h">{o.sendT}</h2>
      <ul class="plain-list">{o.send.map((x) => <li>{x}</li>)}</ul>
    </div>
    <div class="terms-col">
      <h2 class="display">{o.termsT}</h2>
      <ul class="plain-list">{terms.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="work" id="work" aria-labelledby="work-h" data-section="4">
    <div class="work-top">
      <h2 class="display split" id="work-h"><Words text={o.egT} /></h2>
    </div>
    <Reel t={t} ids={ORDER} label={o.egT} pin />
    <p class="work-all"><a class="lnk" href={`${home}#work`}>{t.nav.work}<Icon name="arrow-up-right" size={12} /></a></p>
  </section>

  <section class="faq" id="faq" aria-labelledby="faq-h" data-section="5">
    <h2 class="display split" id="faq-h"><Words text={o.faqT} /></h2>
    <div class="faq-b">
      <Faq items={qs} />
      <p class="faq-more">{h.faq.more} <a class="lnk" {...wa(h.faq.msg)}>{h.faq.ask}<Icon name="arrow-up-right" size={12} /></a></p>
      <Reads t={t} ids={['cost', 'instagram']} />
    </div>
  </section>
</Base>
