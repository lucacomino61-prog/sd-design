---
// A guide: a question an owner asks, the short answer on the first screen, then the long one in numbered parts on
// the light ground, with the way to the other guides. The words are in src/i18n/guides.js. A page to read: nothing
// moves here but the headline's dots and the blocks that rise once.
import '../styles/guide.css';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { GUIDE_TEXT } from '../i18n/guides.js';
import { GUIDES, PAGES, href, abs, workHref } from '../data/site.js';
import { FEATURES } from '../data/features.js';
import { SITES } from '../data/sites.js';

const { t, id } = Astro.props;
const lang = t.lang, G = GUIDE_TEXT[lang], g = G[id], page = `guide-${id}`;
const home = href('home', lang), index = href('guides', lang);
const pad = (n) => String(n).padStart(2, '0');
// A link names a page of the site. One whose page is switched off, or whose feature is, is left out.
const link = ({ to, text, needs }) => {
  const [key, place] = to.split('#');
  if ((needs && !FEATURES[needs]) || !PAGES[key]) return null;
  return { href: PAGES[key][lang] + (place ? `#${place}` : ''), text: text ?? t.kindTitles[key] };
};
const sections = g.sections.map((s, i) => ({ ...s, id: `p${i + 1}`, links: (s.links ?? []).map(link).filter(Boolean) }));
const others = GUIDES.filter((x) => x !== id);

const ORG = abs('/') + '#studio', here = abs(href(page, lang));
const nodes = [
  { '@type': 'Article', '@id': here + '#article', headline: g.h1, description: g.desc, inLanguage: lang, url: here, mainEntityOfPage: { '@id': here + '#page' }, author: { '@id': ORG }, publisher: { '@id': ORG }, image: abs(`/og/${page}-${lang}.jpg`), ...(g.checked && { dateModified: g.checked }) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'SD Design', item: abs(home) }, { '@type': 'ListItem', position: 2, name: G.nav, item: abs(index) }, { '@type': 'ListItem', position: 3, name: g.short, item: here }] },
];
---
<Base t={t} page={page} meta={{ title: g.title, desc: g.desc }} share={`/og/${page}-${lang}.jpg`} nodes={nodes} sections={4}>
  <section class="hero shero ghero" id="top" aria-labelledby="h1" data-section="1">
    <canvas class="tone hero-tone" data-tone="text" data-text={g.glyph} aria-hidden="true"></canvas>
    <div class="hero-b">
      <nav class="crumbs" aria-label={t.ui.crumbs}><ol><li><a href={home}>SD Design</a></li><li><a href={index}>{G.nav}</a></li><li aria-current="page">{g.short}</li></ol></nav>
      <h1 class="display" id="h1">{g.h1}</h1>
      <div class="hero-foot">
        <p class="lead">{g.answer}</p>
        <nav class="gtoc" aria-labelledby="toc-h">
          <h2 id="toc-h">{G.index.onThisPage}</h2>
          <ol>{sections.map((s, i) => <li><a href={`#${s.id}`}><span aria-hidden="true">{pad(i + 1)}</span>{s.h}</a></li>)}</ol>
        </nav>
      </div>
    </div>
  </section>

  <article class="gbody" data-ground="light" data-section="2">
    {sections.map((s, i) => (
      <section class="gsec" id={s.id} aria-labelledby={`${s.id}-h`}>
        <div class="ghead">
          <p class="gnum" aria-hidden="true">{pad(i + 1)}</p>
          <h2 id={`${s.id}-h`}>{s.h}</h2>
        </div>
        <div class="gtext">
          {(s.p ?? []).map((x) => <p>{x}</p>)}
          {s.levels && (
            <ol class="glevels">
              {t.levels.items.map(([title, text, items, eg], k) => (
                <li>
                  <p class="pips" aria-hidden="true">{[0, 1, 2].map((n) => <i class={n <= k ? 'on' : undefined}></i>)}</p>
                  <h3>{title}</h3>
                  <p>{text}</p>
                  <p class="gincl">{items.join(' · ')}</p>
                  <a class="lnk" href={workHref(eg, lang)}>{t.levels.eg}: {SITES[eg].name}<Icon name="arrow-right" size={12} /></a>
                </li>
              ))}
            </ol>
          )}
          {s.list && (typeof s.list[0] === 'string'
            ? <ol class="gitems">{s.list.map((x) => <li>{x}</li>)}</ol>
            : <dl class="gpairs">{s.list.map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}</dl>)}
          {(s.after ?? []).map((x) => <p>{x}</p>)}
          {s.links.length > 0 && <p class="links">{s.links.map((l) => <a class="lnk" href={l.href}>{l.text}<Icon name="arrow-right" size={12} /></a>)}</p>}
        </div>
      </section>
    ))}
    {g.sources && (
      <section class="gsec gsrc" id="sources" aria-labelledby="sources-h">
        <div class="ghead"><h2 id="sources-h">{G.index.sourcesT}</h2></div>
        <div class="gtext">
          <ul class="gitems">{g.sources.map(([name, url]) => <li><a class="lnk" href={url} target="_blank" rel="noopener">{name}<Icon name="arrow-up-right" size={12} /></a></li>)}</ul>
          <p>{g.checkedLine} {g.note}</p>
        </div>
      </section>
    )}
  </article>

  {others.length > 0 && (
    <section class="more" aria-labelledby="more-h" data-section="3">
      <h2 class="more-t" id="more-h">{G.index.othersT}</h2>
      <ul class="more-list">
        {others.map((x) => <li><a href={href(`guide-${x}`, lang)}><span class="display">{G[x].short}</span><Icon name="arrow-up-right" size={28} /></a></li>)}
      </ul>
    </section>
  )}
</Base>
